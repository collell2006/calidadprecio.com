---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CATEGORIES, getCategoryBySlug, type Category } from '../../data/categories';
import { getGuidesByCategory } from '../../data/guides';

export function getStaticPaths() {
  return CATEGORIES.map((cat) => ({
    params: { categoria: cat.slug },
    props: { category: cat },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const guides = getGuidesByCategory(category.slug);
---

<Layout
  title={`${category.name} Calidad-Precio | Guías y Comparativas 2026`}
  description={category.description}
>
  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6 font-medium">
      <a href="/" class="hover:text-emerald-600 transition-colors">Inicio</a>
      <span>/</span>
      <span class="text-slate-700 capitalize">{category.name}</span>
    </nav>

    <!-- Header de Categoría -->
    <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-3xl p-8 sm:p-10 mb-12 shadow-lg">
      <div class="flex items-center gap-4 mb-3">
        <span class="text-4xl sm:text-5xl">{category.icon}</span>
        <div>
          <span class="text-xs uppercase font-extrabold tracking-wider text-emerald-400 block">
            Categoría Especializada
          </span>
          <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-white">
            {category.name}
          </h1>
        </div>
      </div>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mt-2 leading-relaxed">
        {category.description}
      </p>

      <!-- Subcategorías Populares -->
      <div class="mt-6 pt-6 border-t border-slate-700/80 flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold text-slate-400 mr-2">Subcategorías:</span>
        {category.subcategories.map((sub) => (
          sub.slug ? (
            <a
              href={sub.slug}
              class="text-xs font-semibold px-3 py-1.5 rounded-full bg-slate-800 hover:bg-emerald-600 text-slate-200 transition-colors border border-slate-700"
            >
              {sub.name}
            </a>
          ) : (
            <span class="text-xs font-medium px-3 py-1.5 rounded-full bg-slate-800/50 text-slate-400 border border-slate-700/50">
              {sub.name}
            </span>
          )
        ))}
      </div>
    </div>

    <!-- Listado de Guías -->
    <section>
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight">
            Guías de Compra en {category.name}
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            {guides.length} {guides.length === 1 ? 'guía publicada' : 'guías publicadas'} con criterio independiente.
          </p>
        </div>
      </div>

      {guides.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {guides.map((guide) => (
            <a
              href={`/guias/${guide.slug}`}
              class="group bg-white rounded-3xl border border-slate-200 shadow-xs hover:shadow-xl hover:border-slate-300 transition-all duration-300 flex flex-col overflow-hidden"
            >
              <div class="aspect-16/10 bg-slate-100 overflow-hidden relative">
                <img
                  src={guide.quickTable[0]?.image || 'https://images.unsplash.com/photo-1526738549149-8e07eca6c147?w=600&auto=format&fit=crop&q=80'}
                  alt={guide.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <span class="absolute top-3 left-3 bg-slate-900/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-1 rounded-full shadow-xs">
                  {guide.readingTime} lectura
                </span>
                <span class="absolute bottom-3 right-3 bg-emerald-600 text-white text-[11px] font-extrabold px-2.5 py-1 rounded-full shadow-xs">
                  {guide.quickTable[0]?.badge || '🏆 Ganador'}
                </span>
              </div>

              <div class="p-6 flex-1 flex flex-col justify-between">
                <div>
                  <h3 class="text-lg font-black text-slate-900 group-hover:text-emerald-600 transition-colors leading-snug">
                    {guide.title}
                  </h3>
                  <p class="mt-2 text-xs sm:text-sm text-slate-600 line-clamp-2 leading-relaxed">
                    {guide.intro}
                  </p>
                </div>

                <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
                  <div class="text-xs">
                    <span class="text-slate-400 font-semibold block text-[10px]">Recomendación #1:</span>
                    <span class="font-extrabold text-slate-900">{guide.quickTable[0]?.name}</span>
                  </div>
                  <span class="text-xs font-extrabold text-emerald-600 group-hover:translate-x-1 transition-transform">
                    Ver guía →
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-16 bg-white rounded-3xl border border-dashed border-slate-300 p-8">
          <span class="text-4xl block mb-2">{category.icon}</span>
          <h3 class="text-lg font-bold text-slate-800">Guías en fase de redacción</h3>
          <p class="text-xs sm:text-sm text-slate-500 max-w-md mx-auto mt-1">
            Estamos terminando los análisis y las comparativas de precios de {category.name.toLowerCase()}. Suscríbete al canal de alertas para enterarte cuando se publiquen.
          </p>
        </div>
      )}
    </section>
  </main>

  <Footer />
</Layout>
