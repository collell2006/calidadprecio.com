---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AffiliateDisclaimer from '../components/AffiliateDisclaimer.astro';
import { CATEGORIES } from '../data/categories';
import { ALL_GUIDES } from '../data/guides';
---

<Layout
  title="CalidadPrecio.com | El Punto Dulce en Tus Compras"
  description="Recomendaciones y comparativas honestas de productos en relación calidad-precio. Electrodomésticos, muebles, hardware y móviles con comparador multitienda."
>
  <Header />

  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto">
        
        <!-- Badge superior -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-black bg-slate-900 text-white shadow-xs mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          Guías de Compra Independientes • Noviembre 2026
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-950 tracking-tight leading-tight">
          La compra inteligente en cada categoría.
        </h1>

        <p class="mt-5 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto">
          Ni el producto más barato que termina rompiéndose a los seis meses, ni la marca prémium con sobreprecio. Filtramos el <strong>punto dulce de rendimiento, durabilidad y precio</strong> en Amazon, PcComponentes y MediaMarkt.
        </p>

        <!-- Bloque de Métricas y Compromiso -->
        <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-2xl mx-auto text-left">
          <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200/80">
            <span class="text-xl font-black text-slate-900 block">0 €</span>
            <span class="text-[11px] font-semibold text-slate-500">Marcas patrocinadas</span>
          </div>
          <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200/80">
            <span class="text-xl font-black text-emerald-600 block">3+ Tiendas</span>
            <span class="text-[11px] font-semibold text-slate-500">Cotejo de precios</span>
          </div>
          <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200/80">
            <span class="text-xl font-black text-slate-900 block">10 Años</span>
            <span class="text-[11px] font-semibold text-slate-500">Repuestos exigidos</span>
          </div>
          <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200/80">
            <span class="text-xl font-black text-emerald-600 block">100%</span>
            <span class="text-[11px] font-semibold text-slate-500">Criterio técnico</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contenedor Principal -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    
    <!-- Disclaimer Legal Compacto -->
    <AffiliateDisclaimer compact={true} />

    <!-- Sección de Categorías / Departamentos -->
    <section class="mt-12">
      <div class="flex items-end justify-between mb-6">
        <div>
          <span class="text-[11px] uppercase font-black tracking-wider text-emerald-600 block mb-1">
            Departamentos
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight">
            Explora por Categoría
          </h2>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        {CATEGORIES.map((cat) => (
          <a
            href={`/categoria/${cat.slug}`}
            class="bg-white p-5 rounded-2xl border border-slate-200 hover:border-emerald-500 hover:shadow-md transition-all duration-200 flex flex-col items-center text-center group"
          >
            <span class="text-3xl mb-2.5 p-3 rounded-2xl bg-slate-50 group-hover:bg-emerald-50 group-hover:scale-110 transition-all">
              {cat.icon}
            </span>
            <h3 class="font-extrabold text-slate-900 text-sm group-hover:text-emerald-600 transition-colors">
              {cat.name}
            </h3>
            <span class="text-[11px] font-semibold text-slate-400 mt-1">
              {cat.subcategories.length} subcategorías
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Guías Publicadas Destacadas -->
    <section class="mt-16">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
        <div>
          <span class="text-[11px] uppercase font-black tracking-wider text-emerald-600 block mb-1">
            Análisis Rigurosos
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight">
            Guías de Compra Actualizadas
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-slate-500 max-w-md">
          Comparativas con pros, contras y precios en tiempo real de los comercios con mejor garantía.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {ALL_GUIDES.map((guide) => (
          <a
            href={`/guias/${guide.slug}`}
            class="group bg-white rounded-3xl border border-slate-200 hover:border-slate-300 hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden"
          >
            <!-- Imagen con badge -->
            <div class="aspect-16/10 bg-slate-100 overflow-hidden relative">
              <img
                src={guide.quickTable[0]?.image || 'https://images.unsplash.com/photo-1526738549149-8e07eca6c147?w=600&auto=format&fit=crop&q=80'}
                alt={guide.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-3 left-3 flex gap-2">
                <span class="bg-slate-900/90 backdrop-blur-xs text-white text-[11px] font-bold px-2.5 py-1 rounded-full shadow-xs">
                  {guide.categoryName}
                </span>
              </div>
              <span class="absolute bottom-3 right-3 bg-white/95 backdrop-blur-xs text-slate-700 text-[11px] font-bold px-2.5 py-1 rounded-md shadow-xs">
                {guide.readingTime}
              </span>
            </div>

            <!-- Contenido -->
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-black text-slate-900 group-hover:text-emerald-600 transition-colors leading-snug">
                  {guide.title}
                </h3>
                <p class="mt-2 text-xs sm:text-sm text-slate-600 line-clamp-2 leading-relaxed">
                  {guide.intro}
                </p>
              </div>

              <!-- Elección ganadora destacada -->
              <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
                <div class="text-xs">
                  <span class="text-slate-400 font-semibold block text-[10px]">Recomendación #1:</span>
                  <span class="font-extrabold text-slate-900">{guide.quickTable[0]?.name}</span>
                </div>
                <span class="inline-flex items-center gap-1 text-xs font-extrabold text-emerald-600 group-hover:translate-x-1 transition-transform">
                  Ver guía →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Sección "Nuestro Criterio" -->
    <section id="criterio" class="mt-24 bg-slate-900 text-white rounded-3xl p-8 sm:p-12 relative overflow-hidden">
      <div class="max-w-3xl">
        <span class="text-xs font-black uppercase tracking-widest text-emerald-400 block mb-2">
          Metodología
        </span>
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-white mb-6">
          ¿Cómo definimos qué es realmente "Calidad-Precio"?
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-8">
          Muchas páginas llaman "calidad-precio" al producto con mayor comisión. En <strong>CalidadPrecio.com</strong> aplicamos una fórmula estricta de 3 factores técnicos:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          <div class="bg-slate-800/80 p-5 rounded-2xl border border-slate-700/80">
            <div class="text-2xl mb-2">1️⃣</div>
            <h4 class="font-extrabold text-white text-base mb-1">Rendimiento por Euro</h4>
            <p class="text-xs text-slate-400 leading-relaxed">
              Comparamos especificaciones clave (ej. motor inverter, panel IPS 2K, doble resistencia) frente al coste medio de la categoría.
            </p>
          </div>

          <div class="bg-slate-800/80 p-5 rounded-2xl border border-slate-700/80">
            <div class="text-2xl mb-2">2️⃣</div>
            <h4 class="font-extrabold text-white text-base mb-1">Repuestos y Fiabilidad</h4>
            <p class="text-xs text-slate-400 leading-relaxed">
              Descartamos marcas sin servicio técnico oficial contrastado en España y Europa.
            </p>
          </div>

          <div class="bg-slate-800/80 p-5 rounded-2xl border border-slate-700/80">
            <div class="text-2xl mb-2">3️⃣</div>
            <h4 class="font-extrabold text-white text-base mb-1">Mínimos Históricos</h4>
            <p class="text-xs text-slate-400 leading-relaxed">
              Auditamos el historial de precios para verificar si la rebaja es real o un descuento inflado.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to action: Canal de Telegram -->
    <section id="chollos" class="mt-20 bg-slate-100 border border-slate-200 rounded-3xl p-8 sm:p-10 flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="max-w-xl">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-slate-900 text-white mb-3">
          <span>📢</span> Ofertas en tiempo real
        </span>
        <h3 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Avisos cuando el producto baja a su mínimo histórico
        </h3>
        <p class="text-slate-600 text-sm mt-2 leading-relaxed">
          Los mejores productos bajan de precio durante pocas horas en Amazon o PcComponentes. Avisamos al instante en nuestro canal de Telegram, sin spam y solo con ofertas reales.
        </p>
      </div>

      <div class="shrink-0 flex flex-col sm:flex-row gap-3 w-full md:w-auto">
        <a
          href="https://t.me/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl text-sm font-black text-white bg-slate-900 hover:bg-emerald-600 transition-colors shadow-lg"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.52 2.77-1.16 3.35-1.36 3.73-1.37.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
          </svg>
          Canal de Telegram
        </a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
