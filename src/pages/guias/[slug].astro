---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AffiliateDisclaimer from '../../components/AffiliateDisclaimer.astro';
import ProductCard from '../../components/ProductCard.astro';
import ComparisonTable, { type TableRow } from '../../components/ComparisonTable.astro';
import { getAllGuides } from '../../data/guides';
import type { Guide } from '../../types/guide';

export function getStaticPaths() {
  const guides = getAllGuides();
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;

// Adaptar quickTable a TableRow
const tableProducts: TableRow[] = guide.quickTable.map((item) => ({
  name: item.name,
  badge: item.badge,
  image: item.image,
  keyFeature: item.keyFeature,
  energyClass: item.specPill,
  priceEstimate: item.priceEstimate,
  linkUrl: item.linkAnchor,
  isWinner: item.isWinner,
}));

// Schemas estructurados para SEO en Google
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: 'https://calidadprecio.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: guide.categoryName,
      item: `https://calidadprecio.com/categoria/${guide.category}`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: guide.title,
      item: `https://calidadprecio.com/guias/${guide.slug}`,
    },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.metaDescription,
  image: guide.quickTable[0]?.image || 'https://calidadprecio.com/og-image.jpg',
  datePublished: '2026-11-10T10:00:00+01:00',
  dateModified: '2026-11-10T10:00:00+01:00',
  author: {
    '@type': 'Organization',
    name: 'Equipo Editorial CalidadPrecio.com',
    url: 'https://calidadprecio.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'CalidadPrecio.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://calidadprecio.com/favicon.svg',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://calidadprecio.com/guias/${guide.slug}`,
  },
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: guide.title,
  numberOfItems: guide.products.length,
  itemListElement: guide.products.map((prod, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': 'Product',
      name: prod.name,
      image: prod.image,
      brand: {
        '@type': 'Brand',
        name: prod.brand,
      },
      review: {
        '@type': 'Review',
        reviewRating: {
          '@type': 'Rating',
          ratingValue: prod.score,
          bestRating: 10,
        },
        author: {
          '@type': 'Organization',
          name: 'CalidadPrecio.com',
        },
      },
    },
  })),
};

const faqSchema = guide.faqs && guide.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
} : null;

const jsonLd = [
  breadcrumbSchema,
  articleSchema,
  itemListSchema,
  ...(faqSchema ? [faqSchema] : []),
];
---

<Layout
  title={`${guide.title} | CalidadPrecio.com`}
  description={guide.metaDescription}
  jsonLd={jsonLd}
>
  <Header />

  <!-- Breadcrumbs & Titular con marcado semántico HTML5 -->
  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-16">
    <nav aria-label="Ruta de navegación" class="flex items-center gap-2 text-xs text-slate-400 mb-4 font-medium">
      <a href="/" class="hover:text-emerald-600 transition-colors">Inicio</a>
      <span>/</span>
      <a href={`/categoria/${guide.category}`} class="hover:text-emerald-600 transition-colors capitalize">
        {guide.categoryName}
      </a>
      <span>/</span>
      <span class="text-slate-700 font-semibold">{guide.title.split(':')[0]}</span>
    </nav>

    <header class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-extrabold bg-emerald-100 text-emerald-800 mb-3">
        <span>✓</span> Guía de Compra Actualizada ({guide.lastUpdated})
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-950 tracking-tight leading-tight">
        {guide.title}
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed max-w-3xl">
        {guide.intro}
      </p>

      <div class="mt-5 flex flex-wrap items-center gap-4 text-xs font-semibold text-slate-500 border-b border-slate-200 pb-6">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Tiempo de lectura: {guide.readingTime}
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Revisión técnica independiente
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 18h12l3-18H3z" /></svg>
          Comparativa de precios multitienda
        </span>
      </div>
    </header>

    <!-- Caja de resumen rápido / Key Takeaway -->
    <div class="bg-gradient-to-r from-emerald-500 to-teal-600 text-white rounded-3xl p-6 sm:p-7 shadow-lg my-8">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-2xl bg-white/20 flex items-center justify-center font-black text-xl shrink-0">
          💡
        </div>
        <div>
          <h3 class="text-lg font-black tracking-tight mb-1">
            {guide.verdictTitle}
          </h3>
          <p class="text-sm text-emerald-50 leading-relaxed font-medium">
            {guide.verdictText}
          </p>
        </div>
      </div>
    </div>

    <!-- Comparativa Rápida en Tabla -->
    {guide.quickTable && guide.quickTable.length > 0 && (
      <ComparisonTable products={tableProducts} />
    )}

    <!-- Disclaimer de transparencia -->
    <AffiliateDisclaimer />

    <!-- Fichas detalladas de productos -->
    <section class="mt-12 space-y-12">
      <div class="border-b border-slate-200 pb-3">
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Análisis de los modelos seleccionados
        </h2>
        <p class="text-sm text-slate-500 mt-1">
          Puntos fuertes, debilidades y ofertas en comercios de confianza.
        </p>
      </div>

      {guide.products.map((product) => (
        <div id={product.id}>
          <ProductCard
            badge={product.badge}
            badgeColor={product.badgeColor || 'emerald'}
            rankNumber={product.rankNumber}
            score={product.score}
            name={product.name}
            brand={product.brand}
            image={product.image}
            specs={product.specs}
            whyBestValue={product.whyBestValue}
            targetUser={product.targetUser}
            pros={product.pros}
            cons={product.cons}
            offers={product.offers}
          />
        </div>
      ))}
    </section>

    <!-- Guía de compra: En qué fijarse -->
    {guide.buyerTips && guide.buyerTips.length > 0 && (
      <article class="mt-16 pt-12 border-t border-slate-200">
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mb-6">
          {guide.buyerTipsTitle || 'Guía Rápida: Los puntos clave para no tirar el dinero'}
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-slate-700">
          {guide.buyerTips.map((tip) => (
            <div class="bg-white p-6 rounded-2xl border border-slate-200">
              <h3 class="font-extrabold text-base text-slate-900 mb-2 flex items-center gap-2">
                <span>{tip.icon}</span> {tip.title}
              </h3>
              <p class="leading-relaxed text-slate-600">
                {tip.description}
              </p>
            </div>
          ))}
        </div>
      </article>
    )}

    <!-- FAQ (Preguntas Frecuentes) -->
    {guide.faqs && guide.faqs.length > 0 && (
      <section class="mt-16 bg-slate-100/70 rounded-3xl p-6 sm:p-8 border border-slate-200">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight mb-4">
          Preguntas Frecuentes
        </h2>
        <div class="space-y-4 text-sm">
          {guide.faqs.map((faq, index) => (
            <details class="bg-white rounded-xl p-4 border border-slate-200 cursor-pointer group" open={index === 0}>
              <summary class="font-bold text-slate-900 flex justify-between items-center">
                {faq.question}
                <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="text-slate-600 mt-2 leading-relaxed">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

  </main>

  <Footer />
</Layout>
