---
export interface TableRow {
  name: string;
  badge: string;
  image: string;
  keyFeature: string;
  energyClass: string;
  priceEstimate: string;
  linkUrl: string;
  isWinner?: boolean;
}

interface Props {
  title?: string;
  subtitle?: string;
  products: TableRow[];
}

const {
  title = 'Comparativa Rápida: De un vistazo',
  subtitle = 'Para los que no quieren leer toda la guía: nuestras 4 recomendaciones según presupuesto.',
  products = [],
} = Astro.props;
---

<div class="my-8 bg-white rounded-3xl border border-slate-200/90 shadow-sm overflow-hidden">
  <div class="p-5 sm:p-6 bg-slate-50/70 border-b border-slate-100">
    <h3 class="text-lg sm:text-xl font-black text-slate-900 tracking-tight flex items-center gap-2">
      <span>⚡</span> {title}
    </h3>
    <p class="text-xs sm:text-sm text-slate-500 mt-1">
      {subtitle}
    </p>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm border-collapse">
      <thead>
        <tr class="bg-slate-100/60 text-slate-700 text-xs font-bold uppercase tracking-wider border-b border-slate-200">
          <th class="p-4 pl-6">Producto</th>
          <th class="p-4">Premio / Categoría</th>
          <th class="p-4">Capacidad / Clave</th>
          <th class="p-4">Eficiencia</th>
          <th class="p-4">Precio aprox.</th>
          <th class="p-4 pr-6 text-right">Comprar</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {products.map((p) => (
          <tr class={`transition-colors ${p.isWinner ? 'bg-emerald-50/30 font-medium' : 'hover:bg-slate-50/60'}`}>
            <td class="p-4 pl-6">
              <div class="flex items-center gap-3">
                <img
                  src={p.image}
                  alt={p.name}
                  class="w-12 h-12 rounded-xl object-cover border border-slate-200 shrink-0"
                />
                <div>
                  <span class="font-extrabold text-slate-900 block leading-tight">
                    {p.name}
                  </span>
                  {p.isWinner && (
                    <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded">
                      Nuestra elección
                    </span>
                  )}
                </div>
              </div>
            </td>

            <td class="p-4">
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-800">
                {p.badge}
              </span>
            </td>

            <td class="p-4 text-slate-600 font-medium">
              {p.keyFeature}
            </td>

            <td class="p-4">
              <span class="inline-flex items-center justify-center px-2 py-0.5 rounded-md text-xs font-extrabold bg-emerald-100 text-emerald-800">
                {p.energyClass}
              </span>
            </td>

            <td class="p-4">
              <span class="font-extrabold text-slate-900 text-base">
                {p.priceEstimate}
              </span>
            </td>

            <td class="p-4 pr-6 text-right">
              <a
                href={p.linkUrl}
                target="_blank"
                rel="nofollow sponsored noopener noreferrer"
                class={`inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold transition-all ${
                  p.isWinner
                    ? 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm shadow-emerald-600/30'
                    : 'bg-slate-900 hover:bg-slate-800 text-white'
                }`}
              >
                <span>Ver precio</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
