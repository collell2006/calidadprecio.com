---
import { CATEGORIES } from '../data/categories';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/98 backdrop-blur-md border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Logo y Marca -->
      <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="CalidadPrecio.com Inicio">
        <div class="w-9 h-9 rounded-xl bg-slate-900 text-white flex items-center justify-center font-black text-sm shadow-xs group-hover:bg-emerald-600 transition-colors">
          CP
        </div>
        <div class="flex flex-col">
          <span class="text-lg font-black tracking-tight text-slate-950 group-hover:text-emerald-600 transition-colors">
            Calidad<span class="text-emerald-600">Precio</span><span class="text-xs text-slate-400 font-semibold">.com</span>
          </span>
          <span class="text-[9px] uppercase tracking-wider font-extrabold text-slate-400 -mt-1">
            Comprar con criterio
          </span>
        </div>
      </a>

      <!-- Navegación Desktop con Mega Menú -->
      <nav class="hidden lg:flex items-center space-x-1 font-semibold text-sm">
        
        <!-- Botón Mega Menú de Categorías -->
        <div class="relative group">
          <button
            type="button"
            class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-slate-800 hover:text-emerald-700 hover:bg-emerald-50/80 transition-colors cursor-pointer"
            id="categories-dropdown-btn"
            aria-expanded="false"
          >
            <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" />
            </svg>
            <span class="font-bold">Categorías y Submenús</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Mega Menú Desplegable con todos los Submenús -->
          <div class="absolute -left-12 top-full pt-2 w-[840px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 ease-out z-50">
            <div class="bg-white rounded-3xl shadow-2xl border border-slate-200 p-6 overflow-hidden">
              
              <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-5">
                <span class="text-xs font-black uppercase tracking-wider text-slate-400">
                  Explorar todos los departamentos y subcategorías
                </span>
                <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2.5 py-0.5 rounded-full">
                  5 Departamentos • Guías Calidad-Precio
                </span>
              </div>

              <!-- Grid de 3 columnas para submenús -->
              <div class="grid grid-cols-3 gap-6">
                {CATEGORIES.slice(0, 3).map((cat) => (
                  <div>
                    <a
                      href={`/categoria/${cat.slug}`}
                      class="flex items-center gap-2 text-sm font-black text-slate-900 hover:text-emerald-600 mb-2.5 pb-1 border-b border-slate-100 group/title"
                    >
                      <span class="text-base">{cat.icon}</span>
                      <span>{cat.name}</span>
                      <span class="text-[10px] text-emerald-600 opacity-0 group-hover/title:opacity-100 transition-opacity ml-auto">Ver todo →</span>
                    </a>
                    <ul class="space-y-1.5 text-xs">
                      {cat.subcategories.map((sub) => (
                        <li>
                          {sub.slug ? (
                            <a
                              href={sub.slug}
                              class="flex items-center justify-between py-1 px-2 rounded-lg text-slate-600 hover:text-emerald-700 hover:bg-emerald-50 transition-colors font-medium"
                            >
                              <span>{sub.name}</span>
                              {sub.badge && (
                                <span class="text-[9px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800">
                                  {sub.badge}
                                </span>
                              )}
                            </a>
                          ) : (
                            <span class="flex items-center justify-between py-1 px-2 text-slate-400">
                              <span>{sub.name}</span>
                              <span class="text-[9px] text-slate-300">Pronto</span>
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>

              <!-- Fila inferior: Móviles y Cocina -->
              <div class="grid grid-cols-3 gap-6 mt-6 pt-5 border-t border-slate-100">
                {CATEGORIES.slice(3, 5).map((cat) => (
                  <div>
                    <a
                      href={`/categoria/${cat.slug}`}
                      class="flex items-center gap-2 text-sm font-black text-slate-900 hover:text-emerald-600 mb-2.5 pb-1 border-b border-slate-100 group/title"
                    >
                      <span class="text-base">{cat.icon}</span>
                      <span>{cat.name}</span>
                      <span class="text-[10px] text-emerald-600 opacity-0 group-hover/title:opacity-100 transition-opacity ml-auto">Ver todo →</span>
                    </a>
                    <ul class="space-y-1.5 text-xs">
                      {cat.subcategories.map((sub) => (
                        <li>
                          {sub.slug ? (
                            <a
                              href={sub.slug}
                              class="flex items-center justify-between py-1 px-2 rounded-lg text-slate-600 hover:text-emerald-700 hover:bg-emerald-50 transition-colors font-medium"
                            >
                              <span>{sub.name}</span>
                              {sub.badge && (
                                <span class="text-[9px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800">
                                  {sub.badge}
                                </span>
                              )}
                            </a>
                          ) : (
                            <span class="flex items-center justify-between py-1 px-2 text-slate-400">
                              <span>{sub.name}</span>
                              <span class="text-[9px] text-slate-300">Pronto</span>
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}

                <!-- Bloque promocional / Criterio dentro del mega menú -->
                <div class="bg-gradient-to-br from-slate-900 to-slate-800 rounded-2xl p-4 text-white flex flex-col justify-between">
                  <div>
                    <span class="text-[10px] uppercase font-black text-emerald-400 tracking-wider block mb-1">
                      Compromiso Editorial
                    </span>
                    <h4 class="font-extrabold text-sm text-white leading-snug">
                      ¿Cómo elegimos el ganador?
                    </h4>
                    <p class="text-slate-300 text-[11px] mt-1 leading-relaxed">
                      Auditamos historial de precios y exigimos garantía oficial. Ninguna marca puede pagar para subir posiciones.
                    </p>
                  </div>
                  <a
                    href="/#criterio"
                    class="mt-3 inline-flex items-center gap-1 text-[11px] font-black text-emerald-400 hover:text-emerald-300"
                  >
                    Ver nuestra metodología →
                  </a>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- Enlaces directos a departamentos -->
        <a
          href="/categoria/electrodomesticos"
          class={`px-3 py-2 rounded-xl transition-colors ${
            currentPath.includes('electrodomesticos') || currentPath.includes('lavadoras')
              ? 'bg-emerald-50 text-emerald-700 font-bold'
              : 'text-slate-600 hover:text-slate-950 hover:bg-slate-50'
          }`}
        >
          Electrodomésticos
        </a>

        <a
          href="/categoria/muebles"
          class={`px-3 py-2 rounded-xl transition-colors ${
            currentPath.includes('muebles') || currentPath.includes('sillas')
              ? 'bg-emerald-50 text-emerald-700 font-bold'
              : 'text-slate-600 hover:text-slate-950 hover:bg-slate-50'
          }`}
        >
          Muebles
        </a>

        <a
          href="/categoria/hardware"
          class={`px-3 py-2 rounded-xl transition-colors ${
            currentPath.includes('hardware') || currentPath.includes('monitores')
              ? 'bg-emerald-50 text-emerald-700 font-bold'
              : 'text-slate-600 hover:text-slate-950 hover:bg-slate-50'
          }`}
        >
          Hardware PC
        </a>

        <a
          href="/categoria/moviles"
          class={`px-3 py-2 rounded-xl transition-colors ${
            currentPath.includes('moviles')
              ? 'bg-emerald-50 text-emerald-700 font-bold'
              : 'text-slate-600 hover:text-slate-950 hover:bg-slate-50'
          }`}
        >
          Móviles
        </a>

        <a
          href="/categoria/cocina"
          class={`px-3 py-2 rounded-xl transition-colors ${
            currentPath.includes('cocina') || currentPath.includes('freidoras')
              ? 'bg-emerald-50 text-emerald-700 font-bold'
              : 'text-slate-600 hover:text-slate-950 hover:bg-slate-50'
          }`}
        >
          Cocina
        </a>
      </nav>

      <!-- Botones laterales (Metodología y Telegram) -->
      <div class="flex items-center gap-3">
        <a
          href="https://t.me/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-black text-white bg-slate-900 hover:bg-emerald-600 transition-colors shadow-xs"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.52 2.77-1.16 3.35-1.36 3.73-1.37.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
          </svg>
          <span class="hidden sm:inline">Alertas</span> Telegram
        </a>

        <!-- Botón Hamburguesa Móvil -->
        <button
          type="button"
          id="mobile-menu-toggle"
          class="lg:hidden p-2 rounded-xl text-slate-700 hover:bg-slate-100 transition-colors"
          aria-label="Abrir menú"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>

    <!-- Menú Móvil Desplegable con Acordeones -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 py-4 space-y-3">
      <div class="px-2 text-[11px] font-extrabold uppercase tracking-wider text-slate-400">
        Departamentos y Submenús
      </div>
      {CATEGORIES.map((cat) => (
        <details class="group/mob rounded-xl border border-slate-200 bg-white overflow-hidden">
          <summary class="flex items-center justify-between p-3 cursor-pointer font-bold text-sm text-slate-900 hover:bg-slate-50">
            <span class="flex items-center gap-2">
              <span>{cat.icon}</span>
              <span>{cat.name}</span>
            </span>
            <span class="text-xs text-slate-400 group-open/mob:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="p-3 bg-slate-50 border-t border-slate-100 space-y-1.5 text-xs">
            <a
              href={`/categoria/${cat.slug}`}
              class="block font-black text-emerald-700 hover:underline py-1"
            >
              Ver página principal de {cat.name} →
            </a>
            {cat.subcategories.map((sub) => (
              sub.slug ? (
                <a
                  href={sub.slug}
                  class="flex items-center justify-between py-1 px-2 rounded hover:bg-white text-slate-700 font-semibold"
                >
                  <span>{sub.name}</span>
                  {sub.badge && (
                    <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800">
                      {sub.badge}
                    </span>
                  )}
                </a>
              ) : (
                <span class="flex items-center justify-between py-1 px-2 text-slate-400">
                  <span>{sub.name}</span>
                  <span class="text-[9px] text-slate-400">Pronto</span>
                </span>
              )
            ))}
          </div>
        </details>
      ))}
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  toggleBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
