---
export interface StoreOffer {
  name: string; // 'Amazon', 'PcComponentes', 'MediaMarkt', 'AliExpress', 'El Corte Inglés'
  price: string;
  url: string;
  inStock?: boolean;
  highlight?: boolean;
}

interface Props {
  badge?: string; // '🏆 Nuestra Elección Calidad-Precio', '🥈 Opción Económica (<300€)', etc.
  badgeColor?: 'emerald' | 'amber' | 'blue' | 'purple';
  score: number; // e.g. 9.5
  name: string;
  brand: string;
  image?: string;
  specs: string[]; // ['9 kg capacidad', '1400 rpm', 'Motor Inverter Silencioso', 'Clase A']
  whyBestValue: string; // La explicación de por qué es calidad-precio
  targetUser: string; // Para quién es ideal
  pros: string[];
  cons: string[];
  offers: StoreOffer[];
  rankNumber?: number;
}

const {
  badge = '🏆 Nuestra Elección Calidad-Precio',
  badgeColor = 'emerald',
  score = 9.4,
  name,
  brand,
  image = 'https://images.unsplash.com/photo-1626806787461-102c1bfaaea1?w=600&auto=format&fit=crop&q=80',
  specs = [],
  whyBestValue,
  targetUser,
  pros = [],
  cons = [],
  offers = [],
  rankNumber,
} = Astro.props;

const badgeStyles = {
  emerald: 'bg-emerald-600 text-white shadow-emerald-500/20',
  amber: 'bg-amber-500 text-white shadow-amber-500/20',
  blue: 'bg-blue-600 text-white shadow-blue-500/20',
  purple: 'bg-purple-600 text-white shadow-purple-500/20',
};
---

<article class="bg-white rounded-3xl border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-slate-300 transition-all duration-300 overflow-hidden my-8">
  <!-- Cabecera de la ficha con Badge y Puntuación -->
  <div class="bg-slate-50/70 border-b border-slate-100 px-5 sm:px-8 py-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2.5">
      {rankNumber && (
        <span class="w-8 h-8 rounded-full bg-slate-900 text-white text-sm font-extrabold flex items-center justify-center">
          #{rankNumber}
        </span>
      )}
      <span class={`inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs sm:text-sm font-extrabold shadow-sm ${badgeStyles[badgeColor]}`}>
        {badge}
      </span>
    </div>

    <div class="flex items-center gap-2">
      <div class="text-right">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block -mb-1">Puntuación</span>
        <span class="text-lg font-black text-slate-900">{score.toFixed(1)}<span class="text-xs text-slate-400 font-semibold">/10</span></span>
      </div>
      <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 flex items-center justify-center font-black text-sm">
        ★
      </div>
    </div>
  </div>

  <div class="p-5 sm:p-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Imagen y especificaciones clave -->
      <div class="lg:col-span-5 flex flex-col items-center">
        <div class="w-full aspect-4/3 rounded-2xl bg-slate-100 overflow-hidden relative group border border-slate-100">
          <img
            src={image}
            alt={name}
            loading="lazy"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
          />
          <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-xs text-slate-700 text-[11px] font-bold px-2.5 py-1 rounded-md shadow-xs">
            {brand}
          </span>
        </div>

        <!-- Pastillas de características técnicas -->
        <div class="w-full mt-4 flex flex-wrap gap-2">
          {specs.map((spec) => (
            <span class="text-xs font-semibold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 border border-slate-200/60">
              ⚡ {spec}
            </span>
          ))}
        </div>
      </div>

      <!-- Análisis Criterio Calidad-Precio -->
      <div class="lg:col-span-7 flex flex-col">
        <h3 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight leading-snug">
          {name}
        </h3>

        <!-- Por qué es la compra inteligente (El factor diferencial) -->
        <div class="mt-4 p-4 rounded-2xl bg-emerald-50/70 border border-emerald-200/60">
          <h4 class="text-xs font-extrabold uppercase tracking-wider text-emerald-900 flex items-center gap-1.5 mb-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            ¿Por qué es la compra inteligente?
          </h4>
          <p class="text-sm text-emerald-950 font-medium leading-relaxed">
            {whyBestValue}
          </p>
        </div>

        <!-- Para quién es -->
        <div class="mt-3.5 flex items-start gap-2 text-xs sm:text-sm text-slate-600">
          <span class="font-bold text-slate-900 shrink-0">🎯 Ideal para:</span>
          <span>{targetUser}</span>
        </div>

        <!-- Pros y Contras -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-5 pt-5 border-t border-slate-100 text-xs sm:text-sm">
          <div>
            <span class="font-bold text-emerald-700 block mb-2 flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              Lo que más nos gusta
            </span>
            <ul class="space-y-1.5 text-slate-600">
              {pros.map((pro) => (
                <li class="flex items-start gap-1.5">
                  <span class="text-emerald-500 font-bold">•</span>
                  <span>{pro}</span>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <span class="font-bold text-rose-700 block mb-2 flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
              A tener en cuenta (Contras)
            </span>
            <ul class="space-y-1.5 text-slate-600">
              {cons.map((con) => (
                <li class="flex items-start gap-1.5">
                  <span class="text-rose-400 font-bold">•</span>
                  <span>{con}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Comparativa de Precios Multitienda (Conversión alta) -->
    <div class="mt-8 pt-6 border-t border-slate-100 bg-slate-50/50 -mx-5 -mb-5 sm:-mx-8 sm:-mb-8 p-5 sm:p-6 rounded-b-3xl">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">
          🛒 Compara precios en tiendas de confianza:
        </span>
        <span class="text-[11px] font-medium text-slate-400 hidden sm:inline">
          Precios actualizados automáticamente
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        {offers.map((offer) => (
          <a
            href={offer.url}
            target="_blank"
            rel="nofollow sponsored noopener noreferrer"
            class={`flex items-center justify-between px-4 py-3 rounded-xl border transition-all duration-200 group ${
              offer.highlight
                ? 'bg-slate-900 border-slate-900 text-white shadow-md hover:bg-emerald-600 hover:border-emerald-600'
                : 'bg-white border-slate-200 text-slate-800 hover:border-emerald-500 hover:shadow-xs'
            }`}
          >
            <div class="flex flex-col">
              <span class={`text-[11px] font-bold ${offer.highlight ? 'text-slate-300 group-hover:text-white' : 'text-slate-400'}`}>
                {offer.name}
              </span>
              <span class="text-base font-extrabold tracking-tight">
                {offer.price}
              </span>
            </div>
            <div class="flex items-center gap-1 text-xs font-bold">
              <span>Ver tienda</span>
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</article>
